# Copy to .env and fill in. Both are read by Bun at runtime and by prisma.config.ts
# (via dotenv) for the Prisma CLI.

# `db` is the docker-compose service name — use this when running the stack with
# `docker compose up`. Running the bot on the host against a published port instead?
# Use localhost. Production points at whatever Postgres the deployment provides.
DATABASE_URL="postgresql://postgres:mangobot@db:5432/postgres?schema=public"

# Leave empty for web-only mode: the web UI runs without a Discord login (and
# without the 30-minute update loop) — useful for local frontend work.
DISCORD_TOKEN=""

# Web UI port (optional, default 3000).
PORT=3000

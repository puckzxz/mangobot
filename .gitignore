# Replaces a 178-line Node template whose wildcards had been corrupted — every `*`
# had become `_` or `\*`, so `*.log`, `*.pid`, `*.tgz` and `data/` were all being
# tracked. `.prettierignore` now excludes this file so that cannot recur.

# Dependencies
node_modules/
.pnpm-store/

# Secrets
.env
.env.*
!.env.template

# Local Postgres volume from docker-compose
data/

# Generated by `pnpm generate` — Prisma 7 emits the client into the project
src/generated/

# Build and tooling output
*.tsbuildinfo
*.log
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/
*.lcov

# Runtime
*.pid
*.pid.lock
*.seed

# Packaging
*.tgz

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

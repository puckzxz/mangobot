// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here — the connection string lives in
// prisma.config.ts for the CLI, and is passed to the driver adapter at runtime.
datasource db {
  provider = "postgresql"
}

model Guild {
  id   String @id
  name String

  // The Discord text channel ID where series updates will be posted
  updatesChannelId String? @map("updates_channel_id")
  catalogChannelId String? @map("catalog_channel_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  series       GuildsSeries[]
  subscription Subscription[]

  @@index([id], name: "index_guilds_guild_id")
  @@index([updatesChannelId], name: "index_guilds_updates_channel_id")
  @@map("guilds")
}

enum SeriesSource {
  MangaDex
  AsuraScans
  WeebCentral
}

model Series {
  id            String @id @default(uuid())
  name          String @unique
  url           String @unique
  latestChapter String @default("0") @map("latest_chapter")
  imageUrl      String? @map("image_url")

  // Relevant for sites like MangaDex where we can use the official API
  sourceId      String?  @map("source_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Renamed from lastCheckedAt. It only ever advanced on a *successful* scrape, so
  // the old name invited reading it as "we looked at this", which it never meant.
  lastSuccessAt DateTime @default(now()) @map("last_success_at")

  // Written every pass, success or failure, so "when did we last try" and "when did
  // it last work" stop being the same column. Their gap is the staleness signal.
  lastAttemptAt DateTime? @map("last_attempt_at")

  // Health axis. Reset to zero by any successful scrape, so a series that recovers
  // needs no intervention. Deliberately carries no "completed" value — a broken
  // scraper must be structurally incapable of being recorded as a finished series.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastFailureReason   String?   @map("last_failure_reason")
  lastFailureMessage  String?   @map("last_failure_message")
  lastFailureAt       DateTime? @map("last_failure_at")

  // The scrape worked but the announcement did not reach anyone. Without this, a
  // series nobody can be told about looks perfectly healthy.
  deliveryFailedAt DateTime? @map("delivery_failed_at")

  // What the source says about the series itself, kept raw because the two sources
  // use different vocabularies (Complete/Canceled vs completed/hiatus/dropped).
  // Normalised for display in src/series-status.ts.
  //
  // Triage only. Measured: of 22 series WeebCentral marks `Complete`, 19 received a
  // chapter within 90 days — the field describes whether the ORIGINAL work ended,
  // not whether this source finished translating it. It must never gate scraping.
  upstreamStatus   String?   @map("upstream_status")
  upstreamStatusAt DateTime? @map("upstream_status_at")

  // The highest chapter NUMBER the source lists, gated chapters included. The gap
  // against latestChapter (the newest we can actually read) is exactly the content
  // sitting behind early access.
  //
  // It replaces source_chapter_count, which held a cardinality — Asura's own
  // `chapterCount` is just `chapters.length`. Subtracting an ordinal from a count
  // made every series numbered from chapter 0, or carrying a decimal chapter, look
  // permanently behind: 10 of the 11 flagged rows were arithmetic, not content.
  // Same units on both sides, or the subtraction means nothing.
  sourceHighestChapter Float? @map("source_highest_chapter")

  // Superseded by sourceHighestChapter and no longer read or written. Kept for one
  // release so the previous image still starts if this deploy has to be rolled
  // back; the next migration drops it.
  sourceChapterCount Int? @map("source_chapter_count")

  author String?

  // What the ORIGINAL work has, from AniList — a different question from
  // sourceHighestChapter, which is what THIS SOURCE has. The gap here means the
  // source has not translated everything yet (the Uma Musume case), and it is the
  // only way to answer that for WeebCentral, which publishes no total of its own.
  //
  // anilistCheckedAt set with anilistId null means "looked, found no confident
  // match" — so a miss is not retried every pass.
  anilistId        Int?      @map("anilist_id")
  anilistTitle     String?   @map("anilist_title")
  anilistChapters  Int?      @map("anilist_chapters")
  anilistCheckedAt DateTime? @map("anilist_checked_at")

  // When the last new chapter was announced. Null for rows that have not had a
  // chapter since the column was added — updatedAt/lastSuccessAt cannot stand in,
  // as every 30-minute pass rewrites them for all series.
  latestChapterAt DateTime? @map("latest_chapter_at")

  // When the SOURCE published that chapter. latestChapterAt records when we
  // noticed, which is a different thing and cannot answer "how long has this been
  // quiet?" — every row would look fresh the moment the bot restarts.
  latestChapterPublishedAt DateTime? @map("latest_chapter_published_at")

  source SeriesSource

  guilds       GuildsSeries[]
  subscription Subscription[]

  @@map("series")
}

model GuildsSeries {
  id        String   @id @default(uuid())

  guildId   String   @map("guild_id")
  seriesId  String   @map("series_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guild  Guild  @relation(fields: [guildId], references: [id])
  series Series @relation(fields: [seriesId], references: [id])

  @@unique([guildId, seriesId])
  @@index([guildId], name: "index_guilds_series_guild_id")
  @@index([seriesId], name: "index_guilds_series_series_id")
  @@map("guilds_series")
}

model Subscription {
  id        String   @id @default(uuid())

  guildId   String   @map("guild_id")
  seriesId  String   @map("series_id")
  userId    String   @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guild  Guild  @relation(fields: [guildId], references: [id])
  series Series @relation(fields: [seriesId], references: [id])

  @@unique([guildId, seriesId, userId])
  @@index([guildId], name: "index_subscriptions_guild_id")
  @@index([seriesId], name: "index_subscriptions_series_id")
  @@index([userId], name: "index_subscriptions_user_id")
  @@map("subscriptions")
}
